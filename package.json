{
  "name": "stepsafe-praxis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/sync-seva.mjs",
    "build": "node node_modules/typescript-native/bin/tsc --noEmit -p . && vite build && node scripts/offline-manifest.mjs",
    "build:fast": "node scripts/sync-seva.mjs && vite build && node scripts/offline-manifest.mjs",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit -p ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.3",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^6.4.6"
  }
}

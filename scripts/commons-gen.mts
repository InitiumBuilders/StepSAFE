/* THE COMMONS BENEATH: what the known systems rest on, and what one move does for all of them.
   Reads research/outlier/commons.json (which parts of which maps rest on which shared foundation)
   and runs the gauges' model for every one of those parts:
   - if the foundation fails: a blow that nothing holds lands on that part, and the day runs
   - contain: the moves that keep the most of those days across every system resting on it
   - harden: the moves the model rates highest at those parts on the stress day, summed across systems
   Writes src/content/outlier/commons.ts. probe-outlier recomputes it and fails if it drifts.

   npx tsx scripts/commons-gen.mts */

import { readFileSync, writeFileSync } from 'node:fs';
import { MODUX_MODELS } from '../src/content/modux/index';
import { KNOWN_SYSTEMS } from '../src/content/outlier/systems';
import * as own from '../src/content/modux/own';
import { buildModel, simulate, leverage } from '../src/content/modux/dynamics';
import { BREAKERS, DECOUPLERS } from '../src/content/modux/score';
import { verbOf } from '../src/lib/hardening';

const r1 = (x: number) => Math.round(x * 10) / 10;

export function computeCommons() {
  const src = JSON.parse(readFileSync(new URL('../research/outlier/commons.json', import.meta.url), 'utf-8'));
  const byId = new Map(MODUX_MODELS.map(m => [m.id, m]));
  const gauges = new Map<string, any>();
  const gaugeOf = (id: string) => {
    if (!gauges.has(id)) { const spec = own.specFromKnown(id); gauges.set(id, spec ? own.buildOwnGauge(spec, byId) : null); }
    return gauges.get(id);
  };
  const failDay = (g: any, stack: string[], part: string) => {
    const base = buildModel(g, stack, byId);
    const blow = { id: 'x-foundation', name: 'The foundation fails', target: part, p: 1, layers: 0, detect: 0, open: false };
    const m = { ...base, threats: [...base.threats, blow] };
    const { state, samples } = simulate(m, [{ id: blow.id, at: 0.2 }]);
    const end = samples[samples.length - 1];
    return { kept: Math.max(0, 24 - state.lost), falls: end ? Object.keys(end.health).filter(k => end.health[k] < 0.5) : [] };
  };
  const containers = [...new Set([...Object.values(BREAKERS).flat(), ...DECOUPLERS])].filter(id => byId.has(id));

  const foundations = src.foundations.map((f: any) => {
    const rests = (src.rests[f.id] || []).map((key: string) => {
      const [sys, part] = key.split('/');
      const k = KNOWN_SYSTEMS.find(x => x.id === sys);
      const g = gaugeOf(sys);
      const p = k?.map.parts.find(x => x.id === part);
      if (!k || !g || !p) throw new Error('commons.json names a part that is not on a map: ' + key);
      const day = failDay(g, [], part);
      return { system: sys, systemName: k.name, part, partName: p.name, kept: r1(day.kept), falls: day.falls.length, parts: k.map.parts.length };
    });
    /* contain: one move in place everywhere, then the foundation fails */
    const contain = containers.map(id => {
      let gain = 0, helped = 0;
      const per: Record<string, number> = {};
      for (const r of rests) {
        const g = gaugeOf(r.system);
        const with1 = failDay(g, [id], r.part).kept;
        const d = with1 - r.kept;
        if (d > 0.2) { gain += d; helped++; per[r.system] = r1(d); }
      }
      const m = byId.get(id)!;
      return { id, name: m.name, verb: verbOf('breaker', m.family, id), gain: r1(gain), helped, per };
    }).filter(x => x.helped > 0).sort((a, b) => b.gain - a.gain || a.name.localeCompare(b.name)).slice(0, 4);
    /* harden: the stress day's best moves at the parts that rest on it */
    const tally = new Map<string, { id: string; name: string; verb: string; gain: number; helped: number }>();
    for (const r of rests) {
      const g = gaugeOf(r.system);
      for (const mv of leverage(g, [], byId, [], new Set(), 99).moves.filter(x => x.where === r.part)) {
        const t = tally.get(mv.id) || { id: mv.id, name: mv.name, verb: verbOf(mv.kind, byId.get(mv.id)?.family, mv.id), gain: 0, helped: 0 };
        t.gain += mv.kept; t.helped++;
        tally.set(mv.id, t);
      }
    }
    const harden = [...tally.values()].map(t => ({ ...t, gain: r1(t.gain) })).filter(t => t.gain >= 0.5).sort((a, b) => b.gain - a.gain || b.helped - a.helped).slice(0, 3);
    const lost = r1(rests.reduce((s: number, r: any) => s + (24 - r.kept), 0));
    return { id: f.id, name: f.name, line: f.line, entry: f.entry, hue: f.hue, rests, lost, contain, harden };
  });
  return { foundations, bedrock: src.bedrock as { id: string; name: string; line: string; entry: string }[] };
}

if (process.argv[1] && /commons-gen/.test(process.argv[1])) {
  const data = computeCommons();
  const out = `/* GENERATED by scripts/commons-gen.mts from research/outlier/commons.json and the gauges' model.
   Do not edit by hand. */

export interface CommonsRest { system: string; systemName: string; part: string; partName: string; kept: number; falls: number; parts: number }
export interface CommonsMove { id: string; name: string; verb: string; gain: number; helped: number; per?: Record<string, number> }
export interface Foundation { id: string; name: string; line: string; entry: string | null; hue: string; rests: CommonsRest[]; lost: number; contain: CommonsMove[]; harden: CommonsMove[] }

export const COMMONS: { foundations: Foundation[]; bedrock: { id: string; name: string; line: string; entry: string }[] } = ${JSON.stringify(data, null, 1)};
`;
  writeFileSync(new URL('../src/content/outlier/commons.ts', import.meta.url), out.replace(/\r\n/g, '\n'));
  for (const f of data.foundations) console.log(f.name.padEnd(28) + f.rests.length + ' systems, ' + f.lost + ' h lost if it fails | contain: ' + f.contain.map(c => c.name + ' +' + c.gain + 'h/' + c.helped).join(', ') + ' | harden: ' + f.harden.map(c => c.name + ' ' + c.helped + '/' + c.gain + 'h').join(', '));
}

/* Writes src/content/outline.gen.ts: the outline of the curriculum the app loads at start (content/registry.ts).
   It keeps what Ground, the navigation, the engine and a shared profile read before the rest has loaded: every
   id, title, count and number, the page credentials and seals, each award's name, glyph and statement, each
   guide's domain, each room's sector, awards, count of injects and the minutes of each of its decisions, each Modux model's
   name, family, tier and links (what the gauges' arithmetic reads), and each Modux course's chapter. The long text is left out, emptied in place so a page that
   reads it early shows nothing rather than failing. The glossary and the project templates are left out
   entirely. Everything left out arrives with the rest (content/full.ts).
     npx tsx scripts/content-outline.mts          (write the file)
     npx tsx scripts/content-outline.mts --check  (exit 1 if the file is out of date; probe-outline runs this) */
(globalThis as any).self = globalThis;
import { readFileSync, writeFileSync } from 'node:fs';

export async function buildOutline(): Promise<string> {
  const { FULL } = await import('../src/content/full');
  const drop = (x: any, keys: string[]) => { const o = { ...x }; for (const k of keys) delete o[k]; return o; };
  const step = (s: any) => ({ ...drop(s, ['drill', 'praxis', 'evidence']), blocks: [], statement: '', ...(s.glossary ? { glossary: [] } : {}) });
  const page = (p: any) => ({ ...p, summary: '', competencies: [], steps: p.steps.map(step) });
  const chapter = (c: any) => c && ({ ...c, thesis: '', statement: '', why: '', outcomes: [], sources: [], pages: c.pages.map(page) });
  const rows = (xs: unknown[]) => '[\n' + xs.map(x => '    ' + JSON.stringify(x)).join(',\n') + ',\n  ]';
  const out = {
    chapters: FULL.chapters.map(chapter),
    outlier: chapter(FULL.outlier),
    awards: FULL.awards.map((a: any) => ({ ...a, research: '', criteria: '' })),
    guides: FULL.guides.map((g: any) => ({ ...g, statement: '', summary: '', blocks: [], sources: [] })),
    sims: FULL.sims.map((m: any) => ({ ...m, brief: '', objective: '', roles: [], scoring: [], injects: [], debrief: [] })),
    /* a link keeps the model it joins and loses its sentence: the gauges' arithmetic counts links and reads no text */
    moduxModels: FULL.moduxModels.map((m: any) => ({ ...drop(m, ['drill']), statement: '', origin: '', structure: '', components: [], defeats: [], failsWhen: [], evidence: [], systemsLens: '', underStress: '', adoption: '', signals: [], tags: [], combines: m.combines.map((l: any) => ({ model: l.model, how: '' })), ...(m.conflicts ? { conflicts: m.conflicts.map((l: any) => ({ model: l.model, how: '' })) } : {}) })),
    moduxChapters: FULL.moduxChapters.map(chapter),
  };
  return [
    '/* GENERATED by scripts/content-outline.mts from content/full.ts. Do not edit; run npx tsx scripts/content-outline.mts. */',
    "import type { Chapter, Award, Guide, SimModule } from './schema';",
    "import type { ModuxModel } from './modux-schema';",
    '',
    'export const OUTLINE: { chapters: Chapter[]; outlier: Chapter | null; awards: Award[]; guides: Guide[]; sims: SimModule[]; moduxModels: ModuxModel[]; moduxChapters: Chapter[] } = {',
    '  chapters: ' + rows(out.chapters) + ',',
    '  outlier: ' + JSON.stringify(out.outlier) + ',',
    '  awards: ' + rows(out.awards) + ',',
    '  guides: ' + rows(out.guides) + ',',
    '  sims: ' + rows(out.sims) + ',',
    '  moduxModels: ' + rows(out.moduxModels) + ',',
    '  moduxChapters: ' + rows(out.moduxChapters) + ',',
    '};',
    '',
  ].join('\n');
}

const FILE = new URL('../src/content/outline.gen.ts', import.meta.url);
if (process.argv[1] && /content-outline\.mts$/.test(process.argv[1].replace(/\\/g, '/'))) {
  const text = await buildOutline();
  if (process.argv.includes('--check')) {
    let now = '';
    try { now = readFileSync(FILE, 'utf8'); } catch { /* missing */ }
    if (now !== text) { console.log('src/content/outline.gen.ts is out of date: run npx tsx scripts/content-outline.mts'); process.exit(1); }
    console.log('outline: up to date');
  } else {
    writeFileSync(FILE, text);
    console.log('outline: wrote ' + Math.round(text.length / 1024) + ' KB');
  }
}

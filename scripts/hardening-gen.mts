/* Computes the hardening week for every known system and writes the moves the
   weeks pick most into src/content/outlier/hardening.ts. Nothing is researched
   here: every number comes from running the gauges' model. probe-outlier
   recomputes it and fails if the file no longer matches.

   npx tsx scripts/hardening-gen.mts */

import { writeFileSync } from 'node:fs';
import { MODUX_MODELS } from '../src/content/modux/index';
import { KNOWN_SYSTEMS } from '../src/content/outlier/systems';
import * as own from '../src/content/modux/own';
import { readSystem } from '../src/lib/systemRead';
import { hardeningWeek } from '../src/lib/hardening';

export function computeHardening() {
  const byId = new Map(MODUX_MODELS.map(m => [m.id, m]));
  const tally = new Map<string, { id: string; name: string; verb: string; systems: string[]; first: string[]; gain: number }>();
  const weeks: Record<string, { start: number; end: number; hardest: number; moves: string[] }> = {};
  for (const k of KNOWN_SYSTEMS) {
    const spec = own.specFromKnown(k.id); if (!spec) continue;
    const g = own.buildOwnGauge(spec, byId); if (!g) continue;
    const w = hardeningWeek(g, byId, readSystem(g.system, g.threats, g, byId));
    weeks[k.id] = { start: r1(w.start), end: r1(w.end), hardest: r1(w.hardest), moves: w.lessons.map(l => l.id) };
    w.lessons.forEach((l, i) => {
      const t = tally.get(l.id) || { id: l.id, name: l.name, verb: l.verb, systems: [], first: [], gain: 0 };
      t.systems.push(k.id); if (i === 0) t.first.push(k.id); t.gain += l.gain;
      tally.set(l.id, t);
    });
  }
  const moves = [...tally.values()]
    .map(t => ({ ...t, gain: r1(t.gain / t.systems.length) }))
    .sort((a, b) => b.first.length - a.first.length || b.systems.length - a.systems.length || b.gain - a.gain);
  return { systems: Object.keys(weeks).length, moves, weeks };
}
const r1 = (x: number) => Math.round(x * 10) / 10;

if (process.argv[1] && /hardening-gen/.test(process.argv[1])) {
  const data = computeHardening();
  const out = `/* GENERATED by scripts/hardening-gen.mts from the gauges' model. Do not edit by hand.
   For each known system, the hardening week picks one move a day, each chosen
   after the ones before it. These are the moves the weeks pick, most often first. */

export interface HardeningMove { id: string; name: string; verb: 'model' | 'harden' | 'detect' | 'isolate' | 'restore'; systems: string[]; first: string[]; gain: number }

export const HARDENING: {
  systems: number;
  moves: HardeningMove[];
  weeks: Record<string, { start: number; end: number; hardest: number; moves: string[] }>;
} = ${JSON.stringify(data, null, 2)};
`;
  writeFileSync(new URL('../src/content/outlier/hardening.ts', import.meta.url), out.replace(/\r\n/g, '\n'));
  console.log('hardening: ' + data.systems + ' systems, ' + data.moves.length + ' moves; first: ' + data.moves.slice(0, 5).map(m => m.name + ' ' + m.first.length).join(', '));
}
